---
// Ideb por etapa (três linhas), com faixas por governo, rótulos diretos e legenda.
import { IDEB } from '../data/educacao';
import { num } from '../lib/formato';

const W = 960, H = 320, ESQ = 40, DIR = 150, TOPO = 36, BASE = 28;
const MIN = 3, MAX = 7;
const { anos, series } = IDEB;
const x = (ano: number) => ESQ + ((ano - anos[0]) / (anos.at(-1)! - anos[0])) * (W - ESQ - DIR);
const y = (v: number) => TOPO + ((MAX - v) / (MAX - MIN)) * (H - TOPO - BASE);
const CORES = ['var(--s1)', 'var(--s2)', 'var(--s3)'];

// O Ideb é medido no ano ímpar; a faixa cobre o governo em que a prova foi aplicada
const faixas = [
  { nome: 'Lula', de: 2005, ate: 2010 },
  { nome: 'Dilma', de: 2011, ate: 2016 },
  { nome: 'Temer', de: 2016, ate: 2018 },
  { nome: 'Bolsonaro', de: 2019, ate: 2022 },
  { nome: 'Lula', de: 2023, ate: 2025 },
];
---

<figure class="grafico" aria-label="Evolução do Ideb por etapa de ensino, 2005 a 2025">
  <svg viewBox={`0 0 ${W} ${H}`} role="img">
    {
      faixas.map((f, i) => (
        <>
          {i % 2 === 0 && <rect x={x(f.de)} y={TOPO - 26} width={x(f.ate) - x(f.de)} height={H - TOPO - BASE + 26} fill="var(--g-faixa)" />}
          <text class="rotulo-faixa" x={(x(f.de) + x(f.ate)) / 2} y={TOPO - 10} text-anchor="middle">{f.nome}</text>
        </>
      ))
    }
    {
      [3, 4, 5, 6, 7].map((g) => (
        <>
          <line x1={ESQ} x2={W - DIR} y1={y(g)} y2={y(g)} stroke="var(--g-grade)" />
          <text class="eixo" x={ESQ - 6} y={y(g) + 4} text-anchor="end">{g}</text>
        </>
      ))
    }
    {anos.map((a) => <text class="eixo" x={x(a)} y={H - 8} text-anchor="middle">{a}</text>)}
    {
      series.map((s, i) => (
        <>
          <path
            d={s.valores.map((v, j) => `${j ? 'L' : 'M'}${x(anos[j])},${y(v)}`).join('')}
            fill="none"
            stroke={CORES[i]}
            stroke-width="2"
            stroke-linejoin="round"
          />
          {s.valores.map((v, j) => (
            <circle cx={x(anos[j])} cy={y(v)} r="4" fill={CORES[i]} stroke="var(--superficie)" stroke-width="2">
              <title>{`${s.nome}, ${anos[j]}: ${num(v)}`}</title>
            </circle>
          ))}
          <text x={x(anos.at(-1)!) + 10} y={y(s.valores.at(-1)!) + 4} style="font-size:12px;font-weight:600;fill:var(--tinta)">
            {num(s.valores.at(-1)!)} · {s.nome.split(' (')[0]}
          </text>
        </>
      ))
    }
  </svg>
  <div class="legenda" style="margin-top:6px">
    {series.map((s, i) => <span><i style={`background:${CORES[i]}`} />{s.nome}</span>)}
  </div>
  <figcaption class="fonte-grafico">Ideb de 0 a 10, redes pública e privada. Fonte: Inep/MEC. Passe o mouse nos pontos para ver o valor.</figcaption>
</figure>
