---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Promessa from '../components/Promessa.astro';
import { getMandatos } from '../lib/dados';
import { PENDENTES } from '../lib/status';
import { url } from '../lib/url';

const mandatos = await getMandatos();
const atual = mandatos.at(-1)!;
const presidente = (await getEntry(atual.data.presidente))!;
const nome = presidente.data.nome;

// Só cobra o que o próprio presidente atual deixou pendente
const pendentes = mandatos
  .filter((m) => m.id !== atual.id && m.data.presidente.id === presidente.id)
  .flatMap((m) =>
    m.data.promessas
      .filter((p) => PENDENTES.includes(p.status))
      .map((p) => ({ ...p, origem: `${m.data.ordem}º mandato` })),
  );
---

<Base
  titulo={`O que cobrar de ${nome}`}
  descricao={`Promessas pendentes e novos compromissos de ${nome} para ${atual.data.inicio}–${atual.data.fim}.`}
>
  <h1>O que cobrar de {nome} no {atual.data.ordem}º mandato</h1>
  <p class="suave">
    {atual.data.inicio}–{atual.data.fim}. Esta página junta o que foi prometido na campanha de {atual.data.eleicao}
    com o que o próprio {nome} deixou pendente nos mandatos anteriores.
  </p>

  <h2>Promessas da campanha de {atual.data.eleicao} ({atual.data.promessas.length})</h2>
  <ul class="promessas">
    {atual.data.promessas.map((p) => <Promessa {...p} />)}
  </ul>
  <p><a href={url(`/mandatos/${atual.id}/`)}>Acompanhar o {atual.data.ordem}º mandato →</a></p>

  {
    pendentes.length > 0 && (
      <>
        <h2>Pendências de mandatos anteriores ({pendentes.length})</h2>
        <p class="suave">Promessas de {nome} não cumpridas, parciais ou ainda em andamento.</p>
        <ul class="promessas">
          {pendentes.map((p) => (
            <Promessa {...p} />
          ))}
        </ul>
      </>
    )
  }
</Base>
