---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Placar from '../components/Placar.astro';
import { getMandatos, getPresidentes, periodo } from '../lib/dados';
import { url, dataBR } from '../lib/url';

const artigos = (await getCollection('artigos', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 5);
const presidentes = await getPresidentes();
const atual = (await getMandatos()).at(-1)!;
const presidenteAtual = (await getEntry(atual.data.presidente))!;
---

<Base>
  <section class="hero">
    <h1>República Brasileira</h1>
    <p>
      O que foi prometido, o que foi feito e o que ainda precisa ser cobrado. Todos os presidentes desde o fim da
      ditadura, com fontes.
    </p>
  </section>

  <a class="cartao destaque" href={url('/cobrancas/')}>
    <p class="suave">Mandato atual · {atual.data.inicio}–{atual.data.fim}</p>
    <h3>O que cobrar de {presidenteAtual.data.nome} no {atual.data.ordem}º mandato →</h3>
    <p>{atual.data.promessas.length} promessas de campanha para acompanhar, mais as pendências dos mandatos anteriores.</p>
  </a>

  <h2>Presidentes desde 1985</h2>
  <div class="cartoes">
    {
      presidentes.map((p) => (
        <a class="cartao" href={url(`/presidentes/${p.id}/`)}>
          <h3>{p.data.nome}</h3>
          <p class="suave">
            {p.data.partido} · {periodo(p)}
          </p>
          <Placar promessas={p.mandatos.flatMap((m) => m.data.promessas)} />
        </a>
      ))
    }
  </div>

  <h2>Últimos artigos</h2>
  <ul class="lista-artigos">
    {
      artigos.map((a) => (
        <li>
          <a href={url(`/artigos/${a.id}/`)}>{a.data.titulo}</a>
          <div class="suave">
            {dataBR(a.data.data)} — {a.data.descricao}
          </div>
        </li>
      ))
    }
  </ul>
  <p><a href={url('/artigos/')}>Ver todos os artigos →</a></p>
</Base>
