---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Placar from '../components/Placar.astro';
import { url, dataBR } from '../lib/url';

const artigos = (await getCollection('artigos', ({ data }) => !data.rascunho))
  .sort((a, b) => b.data.data.valueOf() - a.data.data.valueOf())
  .slice(0, 5);
const mandatos = (await getCollection('mandatos')).sort((a, b) => a.data.numero - b.data.numero);
const atual = mandatos.at(-1);
---

<Base>
  <section class="hero">
    <h1>República Brasileira</h1>
    <p>
      O que foi prometido, o que foi feito e o que ainda precisa ser cobrado. Análises e ideias sobre a política
      brasileira, com fontes.
    </p>
  </section>

  <h2>Mandatos</h2>
  <div class="cartoes">
    {
      mandatos.map((m) => (
        <a class="cartao" href={url(`/mandatos/${m.id}/`)}>
          <h3>{m.data.numero}º mandato</h3>
          <p class="suave">
            {m.data.presidente} · {m.data.inicio}–{m.data.fim}
          </p>
          <Placar promessas={m.data.promessas} />
        </a>
      ))
    }
  </div>

  {
    atual && (
      <p>
        <a href={url('/cobrancas/')}>
          <strong>O que cobrar do {atual.data.numero}º mandato →</strong>
        </a>
      </p>
    )
  }

  <h2>Últimos artigos</h2>
  <ul class="lista-artigos">
    {
      artigos.map((a) => (
        <li>
          <a href={url(`/artigos/${a.id}/`)}>{a.data.titulo}</a>
          <div class="suave">
            {dataBR(a.data.data)} — {a.data.descricao}
          </div>
        </li>
      ))
    }
  </ul>
  <p><a href={url('/artigos/')}>Ver todos os artigos →</a></p>
</Base>
