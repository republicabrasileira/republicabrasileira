---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, dataBR } from '../../lib/url';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => !data.rascunho);
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
---

<Base titulo={artigo.data.titulo} descricao={artigo.data.descricao}>
  <article class="artigo">
    <p class="suave"><a href={url('/artigos/')}>← Artigos</a></p>
    <h1>{artigo.data.titulo}</h1>
    <p class="suave">
      {dataBR(artigo.data.data)}
      {artigo.data.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
    <Content />
  </article>
</Base>
