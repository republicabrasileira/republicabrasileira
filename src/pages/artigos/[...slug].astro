---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, dataBR } from '../../lib/url';
import { minutosDeLeitura } from '../../lib/formato';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => !data.rascunho);
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
const minutos = minutosDeLeitura(artigo.body ?? '');
---

<Base titulo={artigo.data.titulo} descricao={artigo.data.descricao}>
  <article class="artigo">
    <header>
      <p class="pequeno"><a href={url('/artigos/')}>← Opinião</a></p>
      <span class="selo-pilar opiniao">Opinião</span>
      <h1>{artigo.data.titulo}</h1>
      <p class="lead">{artigo.data.descricao}</p>
      <span class="data">
        {dataBR(artigo.data.data)}
        {artigo.data.atualizado && <> · editado em {dataBR(artigo.data.atualizado)}</>} · {minutos} min de leitura
      </span>
      <div class="aviso-leitura">
        <span><span class="selo-pilar fatos">Fatos</span> com fonte no fim do texto</span>
        <span><span class="selo-pilar opiniao">Opinião</span> do autor, assumida</span>
      </div>
    </header>
    <div class="corpo">
      <Content />
    </div>
    <p style="margin-top:32px">
      {artigo.data.tags.map((t) => <span class="tag">{t}</span>)}
    </p>
  </article>
</Base>
