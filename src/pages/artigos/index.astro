---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { url, dataBR } from '../../lib/url';

const artigos = (await getCollection('artigos', ({ data }) => !data.rascunho)).sort(
  (a, b) => b.data.data.valueOf() - a.data.data.valueOf(),
);
---

<Base titulo="Artigos" descricao="Textos, análises e ideias sobre a política brasileira.">
  <h1>Artigos</h1>
  <ul class="lista-artigos">
    {
      artigos.map((a) => (
        <li>
          <a href={url(`/artigos/${a.id}/`)}>{a.data.titulo}</a>
          <div class="suave">
            {dataBR(a.data.data)} — {a.data.descricao}
          </div>
          <div>
            {a.data.tags.map((t) => (
              <span class="tag">{t}</span>
            ))}
          </div>
        </li>
      ))
    }
  </ul>
</Base>
