---
import { getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Placar from '../../components/Placar.astro';
import { getMandatos, FORMA_LABEL } from '../../lib/dados';
import { url } from '../../lib/url';

const mandatos = await Promise.all(
  (await getMandatos()).map(async (m) => ({ ...m, presidente: (await getEntry(m.data.presidente))! })),
);
---

<Base titulo="Linha do tempo" descricao="Todos os mandatos presidenciais desde 1985, em ordem cronológica.">
  <h1>Linha do tempo</h1>
  <p class="suave">Todos os mandatos desde 1985, em ordem.</p>
  <div class="cartoes">
    {
      mandatos.map((m) => (
        <a class="cartao" href={url(`/mandatos/${m.id}/`)}>
          <h3>
            {m.data.inicio}–{m.data.fim} · {m.presidente.data.nome}
          </h3>
          <p class="suave">
            {m.data.ordem}º mandato · {FORMA_LABEL[m.data.forma]}
          </p>
          <Placar promessas={m.data.promessas} />
        </a>
      ))
    }
  </div>
</Base>
