---
import '../styles/global.css';
import { url } from '../lib/url';

interface Props {
  titulo?: string;
  descricao?: string;
}

const NOME = 'República Brasileira';
const { titulo, descricao = 'O que eu penso, o que os fatos mostram e o que devemos cobrar dos presidentes do Brasil.' } = Astro.props;
const tituloPagina = titulo ? `${titulo} · ${NOME}` : NOME;
const atual = Astro.url.pathname;
const links = [
  { href: url('/artigos/'), texto: 'Opinião' },
  { href: url('/presidentes/'), texto: 'Presidentes' },
  { href: url('/economia/'), texto: 'Economia' },
  { href: url('/educacao/'), texto: 'Educação' },
  { href: url('/eleicoes-2026/'), texto: 'Eleições 2026' },
  { href: url('/esquerda-e-direita/'), texto: 'Esquerda e direita' },
  { href: url('/cobrancas/'), texto: 'O que cobrar', classe: 'cobrar' },
  { href: url('/sobre/'), texto: 'Sobre' },
];
const hoje = new Date().toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' });
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descricao} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="faixa" aria-hidden="true"></div>
    <header class="topo">
      <div class="container">
        <div class="topo-linha">
          <span>Brasil · atualizado em {hoje}</span>
          <span>Opinião · Fatos · Cobrança</span>
        </div>
        <a href={url('/')} class="marca">
          <strong>{NOME}</strong>
          <span>Quem promete, deve</span>
        </a>
        <nav class="menu">
          {
            links.map((l) => (
              <a
                href={l.href}
                class={l.classe}
                aria-current={atual === l.href || (l.href !== url('/') && atual.startsWith(l.href)) ? 'page' : undefined}
              >
                {l.texto}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="rodape">
      <div class="container">
        <div class="pilares-mini">
          <span><span class="selo-pilar opiniao">Opinião</span> o que eu penso</span>
          <span><span class="selo-pilar fatos">Fatos</span> o que pesquisamos, com fonte</span>
          <span><span class="selo-pilar cobranca">Cobrança</span> o que devemos cobrar</span>
        </div>
        <p>{NOME} não tem vínculo com partido, candidato ou governo. Encontrou um erro? Ele será corrigido.</p>
      </div>
    </footer>
  </body>
</html>
